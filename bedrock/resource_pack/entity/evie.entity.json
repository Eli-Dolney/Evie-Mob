{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ltw_mobs:evie",
      "materials": {
        "default": "entity_alphatest",
        "glow": "entity_emissive_alpha"
      },
      "textures": {
        "default": "textures/entity/evie",
        "glow": "textures/entity/evie_glow"
      },
      "geometry": {
        "default": "geometry.ltw_mobs.evie"
      },
      "animations": {
        "pose": "animation.ltw_mobs.evie.pose",
        "idle": "animation.ltw_mobs.evie.idle",
        "walk": "animation.ltw_mobs.evie.walk",
        "fly": "animation.ltw_mobs.evie.fly",
        "rest": "animation.ltw_mobs.evie.rest"
      },
      "scripts": {
        "pre_animation": [
          "variable.motion = math.min(query.modified_move_speed * 4.0, 1.0);",
          "variable.flight_blend = math.clamp(variable.flight_blend + (query.property('ltw_mobs:flying') ? 1.0 : -1.0) * query.delta_time * 1.6, 0.0, 1.0);"
        ],
        "animate": [
          "pose",
          "idle",
          {
            "walk": "(1.0 - variable.flight_blend) * !query.property('ltw_mobs:stay')"
          },
          {
            "fly": "variable.flight_blend"
          },
          {
            "rest": "query.property('ltw_mobs:tamed') && query.property('ltw_mobs:stay') && !query.property('ltw_mobs:flying')"
          }
        ],
        "initialize": [
          "variable.flight_blend = 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.ltw_mobs.base",
        "controller.render.ltw_mobs.glow"
      ],
      "spawn_egg": {
        "base_color": "#f4b0d7",
        "overlay_color": "#8425be"
      }
    }
  }
}
